package wisp:network@0.1.0;
interface requests {
  resource response {
    status: func() -> u16;
    body: func() -> string;
  }
  fetch: func(url: string) -> result<response, string>;
  resolve: func(name: string) -> result<u32, string>;
  connect: func(port: u16) -> result<_, string>;
}
world library {
  import wasi:http/outgoing-handler@0.2.12;
  import wasi:sockets/instance-network@0.2.12;
  import wasi:sockets/ip-name-lookup@0.2.12;
  import wasi:sockets/tcp-create-socket@0.2.12;
  export requests;
}
