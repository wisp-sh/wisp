(component
 (core module $m
  (memory (export "memory") 16 16)
  (global $heap (mut i32) (i32.const 1024))
  (func (export "realloc") (param i32 i32) (param $a i32) (param $n i32) (result i32)
   (local $p i32)
   (local.set $p (i32.and (i32.add (global.get $heap) (i32.sub (local.get $a) (i32.const 1))) (i32.sub (i32.const 0) (local.get $a))))
   (global.set $heap (i32.add (local.get $p) (local.get $n)))
   (if (i32.gt_u (global.get $heap) (i32.const 1048576)) (then unreachable))
   (local.get $p))
  (func (export "post") (param i32) (global.set $heap (i32.const 1024)))
  (data (i32.const 64) "empty parcel")
  (func (export "parcel") (param $p i32) (param $n i32) (result i32)
   (if (i32.eqz (local.get $n))
    (then
     (i32.store (i32.const 0) (i32.const 1))
     (i32.store (i32.const 4) (i32.const 64))
     (i32.store (i32.const 8) (i32.const 12)))
    (else
     (i32.store (i32.const 0) (i32.const 0))
     (i32.store (i32.const 4) (i32.const 32))
     (i32.store (i32.const 8) (i32.const 1))
     (i32.store (i32.const 32) (local.get $p))
     (i32.store (i32.const 36) (local.get $n))))
   (i32.const 0)))
 (core instance $i (instantiate $m))
 (type $strings (list string))
 (type $reply (result $strings (error string)))
 (func (export "parcel") (param "text" string) (result $reply)
  (canon lift (core func $i "parcel") (memory $i "memory") (realloc (func $i "realloc")) (post-return (func $i "post"))))
)
